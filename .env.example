# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Cohere — free embeddings (dashboard.cohere.com)
COHERE_API_KEY=your_cohere_api_key_here

# Qdrant vector DB (cloud.qdrant.io)
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# Gmail OAuth2 (console.cloud.google.com)
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URI=http://localhost:3001/api/auth/gmail/callback
GMAIL_REFRESH_TOKEN=your_refresh_token_after_auth

# Your Gmail address
GMAIL_ADDRESS=you@gmail.com

# SMTP (Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_gmail_app_password

# Google Calendar
CALENDAR_ID=primary

# Hot Lead Alerts
ALERT_EMAIL=you@gmail.com

# Twilio WhatsApp (console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ALERT_WHATSAPP_TO=+91xxxxxxxxxx
WHATSAPP_WEBHOOK_URL=https://your-ngrok-url.ngrok-free.dev/api/whatsapp/webhook

# LinkedIn DM Bot
LINKEDIN_MAX_CONNECTS_PER_DAY=3
LINKEDIN_MAX_DMS_PER_DAY=8
LINKEDIN_AUTO_EXECUTE=false

# Port
PORT=3001
